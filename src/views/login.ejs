<div class="login-page">
  <div class="login-card">
    <div class="logo-big">i</div>
    <h1>Welcome back</h1>
    <p class="subtitle">Sign in to manage your API keys</p>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert error">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <div class="body"><%= error %></div>
      </div>
    <% } %>
    <form method="POST" action="/dashboard/login">
      <label>Email
        <input type="email" name="email" required autocomplete="username" value="<%= typeof email !== 'undefined' ? email : '' %>" />
      </label>
      <label>Password
        <input type="password" name="password" required autocomplete="current-password" placeholder="••••••••" />
      </label>
      <button type="submit">Sign in</button>
    </form>
  </div>
</div>
